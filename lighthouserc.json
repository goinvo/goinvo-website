{
  "ci": {
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.7 }],
        "categories:seo": ["error", { "minScore": 0.6 }],
        "categories:performance": ["error", { "minScore": 0.65, "aggregationMethod": "median-run" }],
        "total-blocking-time": ["error", { "maxNumericValue": 600, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "pessimistic" }]
      }
    }
  }
}
