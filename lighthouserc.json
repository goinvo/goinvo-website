{
  "ci": {
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.7 }],
            "categories:seo": ["error", { "minScore": 0.6 }],
            "total-blocking-time": ["error", { "maxNumericValue": 600, "aggregationMethod": "median-run" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "pessimistic" }]
          }
        },
        {
          "matchingUrlPattern": "^https?://[^/]+/$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.6, "aggregationMethod": "median-run" }]
          }
        },
        {
          "matchingUrlPattern": "^https?://[^/]+/.+",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.7, "aggregationMethod": "median-run" }]
          }
        }
      ]
    }
  }
}
